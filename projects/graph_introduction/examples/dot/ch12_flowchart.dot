// フローチャート: ログイン処理の流れ
// 処理は長方形、判断はひし形、開始と終了は角の丸い長方形で描く
digraph login {
    node [fontname="Yu Gothic", shape=box, style=filled, fillcolor=white];
    edge [fontname="Yu Gothic", fontsize=10];

    start [label="開始", shape=box, style="rounded,filled",
           fillcolor="#dbe9f6"];
    input [label="ID とパスワードを受け取る"];
    exists [label="ユーザーが\n存在するか", shape=diamond,
            fillcolor="#f6e3b4"];
    verify [label="パスワードが\n正しいか", shape=diamond,
            fillcolor="#f6e3b4"];
    count [label="失敗回数を数える"];
    locked [label="失敗が\n5 回以上か", shape=diamond, fillcolor="#f6e3b4"];
    lock [label="アカウントをロックする"];
    error [label="エラーを表示する"];
    session [label="セッションを作る"];
    finish [label="終了", shape=box, style="rounded,filled",
            fillcolor="#dbe9f6"];

    start -> input -> exists;
    exists -> verify [label="はい"];
    exists -> error [label="いいえ"];
    verify -> session [label="はい"];
    verify -> count [label="いいえ"];
    count -> locked;
    locked -> lock [label="はい"];
    locked -> error [label="いいえ"];
    lock -> error;
    session -> finish;
    error -> finish;
}
