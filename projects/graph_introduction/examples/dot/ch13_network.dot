// ネットワーク構成図: 小さな Web システムの機器とつながり
// 機器の種類を形と色で区別し、ネットワークの区画をクラスターで囲む
graph network {
    rankdir=TB;
    node [fontname="Yu Gothic", style=filled];
    edge [fontname="Yu Gothic", fontsize=9];

    internet [label="インターネット", shape=ellipse, fillcolor="#eeeeee"];
    firewall [label="ファイアウォール", shape=box, fillcolor="#f28e2b"];

    subgraph cluster_dmz {
        label="DMZ";
        fontname="Yu Gothic";
        style=dashed;
        lb [label="ロードバランサー", shape=box, fillcolor="#f6e3b4"];
        web1 [label="Web サーバー 1", shape=box3d, fillcolor="#dbe9f6"];
        web2 [label="Web サーバー 2", shape=box3d, fillcolor="#dbe9f6"];
    }

    subgraph cluster_internal {
        label="内部ネットワーク";
        fontname="Yu Gothic";
        style=dashed;
        db [label="データベース", shape=cylinder, fillcolor="#c7e9c0"];
        backup [label="バックアップ", shape=cylinder, fillcolor="#c7e9c0"];
    }

    internet -- firewall;
    firewall -- lb [label="HTTPS"];
    lb -- {web1 web2};
    {web1 web2} -- db [label="SQL"];
    db -- backup [style=dashed, label="夜間に複製"];
}
