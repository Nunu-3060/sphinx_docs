// 状態遷移図: 通販サイトの注文の状態
// ノードが状態、エッジが遷移、エッジのラベルが遷移のきっかけ（イベント）
digraph order_state {
    rankdir=LR;
    node [fontname="Yu Gothic", shape=box, style="rounded,filled",
          fillcolor="#dbe9f6"];
    edge [fontname="Yu Gothic", fontsize=10];

    // 開始状態は黒丸、終了状態は二重丸で描く（UML の状態機械図の流儀）
    initial [label="", shape=circle, style=filled, fillcolor=black,
             width=0.2];
    final [label="", shape=doublecircle, style=filled, fillcolor=black,
           width=0.15];

    initial -> 受付済み;
    受付済み -> 支払い済み [label="支払い"];
    受付済み -> キャンセル [label="取り消し"];
    支払い済み -> 発送済み [label="発送"];
    支払い済み -> キャンセル [label="取り消し\n（返金）"];
    発送済み -> 配達完了 [label="受け取り"];
    発送済み -> 支払い済み [label="配達失敗"];
    配達完了 -> final;
    キャンセル -> final;
}
