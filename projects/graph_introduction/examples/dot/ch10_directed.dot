// 有向グラフ: 6 つの Web ページのリンク
// エッジ（->）には向きがあり、「A から B にリンクしている」ことを表す
digraph links {
    rankdir=LR;
    node [shape=box, style="rounded,filled", fillcolor="#dbe9f6",
          fontname="Yu Gothic"];

    トップ -> 製品一覧;
    トップ -> お知らせ;
    製品一覧 -> 製品詳細;
    製品詳細 -> 購入;
    お知らせ -> 製品詳細;
    購入 -> トップ;
}
