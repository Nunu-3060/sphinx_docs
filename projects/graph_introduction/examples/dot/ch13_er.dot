// ER 図: 通販サイトのテーブルとリレーション
// テーブルを HTML 形式のラベルの表で描き、外部キーの参照をエッジで結ぶ。
// エッジの両端の記号でカーディナリティ（1 対多など）を表す
digraph er {
    rankdir=LR;
    node [shape=plain, fontname="Yu Gothic"];
    edge [arrowhead=crowodot, arrowtail=teetee, dir=both];

    customers [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#4e79a7"><font color="white">customers</font></td></tr>
        <tr><td port="id" align="left">id（主キー）</td></tr>
        <tr><td align="left">name</td></tr>
        <tr><td align="left">email</td></tr>
      </table>>];

    orders [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#4e79a7"><font color="white">orders</font></td></tr>
        <tr><td port="id" align="left">id（主キー）</td></tr>
        <tr><td port="customer" align="left">customer_id（外部キー）</td></tr>
        <tr><td align="left">ordered_at</td></tr>
      </table>>];

    order_items [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#4e79a7"><font color="white">order_items</font></td></tr>
        <tr><td port="order" align="left">order_id（外部キー）</td></tr>
        <tr><td port="product" align="left">product_id（外部キー）</td></tr>
        <tr><td align="left">quantity</td></tr>
      </table>>];

    products [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#4e79a7"><font color="white">products</font></td></tr>
        <tr><td port="id" align="left">id（主キー）</td></tr>
        <tr><td align="left">name</td></tr>
        <tr><td align="left">price</td></tr>
      </table>>];

    // 1 人の顧客は 0 件以上の注文を持つ（1 対多）
    customers:id -> orders:customer;
    // 1 件の注文は 0 件以上の明細を持つ（1 対多）
    orders:id -> order_items:order;
    // 1 つの商品は 0 件以上の明細に現れる（1 対多）
    products:id -> order_items:product;
}
