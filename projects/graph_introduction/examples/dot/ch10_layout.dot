// レイアウトの比較に使うグラフ
// 同じグラフを dot、neato、circo、fdp の 4 つのレイアウトエンジンで描く
graph layout {
    node [shape=circle, width=0.35, fixedsize=true, label="",
          style=filled, fillcolor="#4e79a7"];

    a -- {b c d};
    b -- {e f};
    c -- {g h};
    d -- {i j};
    e -- f;
    g -- h;
    i -- j;
    f -- g;
}
