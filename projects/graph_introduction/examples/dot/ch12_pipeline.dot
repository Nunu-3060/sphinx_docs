// DAG（有向非巡回グラフ）: CI/CD パイプラインのジョブの依存関係
// 矢印の元のジョブが終わると、矢印の先のジョブを実行できる
digraph pipeline {
    rankdir=LR;
    node [fontname="Yu Gothic", shape=box, style="rounded,filled",
          fillcolor="#dbe9f6"];

    checkout [label="チェックアウト"];
    lint [label="静的解析"];
    build [label="ビルド"];
    unit [label="単体テスト"];
    integration [label="結合テスト"];
    docs [label="文書の生成"];
    package [label="パッケージ作成"];
    deploy [label="デプロイ", fillcolor="#f6e3b4"];

    checkout -> {lint build docs};
    build -> {unit integration};
    {lint unit integration} -> package;
    {package docs} -> deploy;
}
