// 地形を島の形にする。
// 中心からの距離で高さを下げ、海面より低い所を海面の高さにそろえる。
float d = length(set(@P.x, @P.z)) / chf("radius");  // 0 = 中心、1 = 島の縁
float mask = 1.0 - smooth(0.55, 1.0, d);         // 中心で 1、縁の外で 0
float h = (@P.y + chf("lift")) * mask - chf("depth") * (1.0 - mask);
@P.y = max(h, chf("sea_level"));
f@height = @P.y;  // 後のノードで使えるように、高さを属性として残す
