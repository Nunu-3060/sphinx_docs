[gd_scene format=3]

[ext_resource type="Script" path="res://chapter14/audio_demo.gd" id="1_audio"]
[ext_resource type="AudioStream" path="res://assets/bgm.wav" id="2_bgm"]

[node name="AudioDemo" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_audio")

[node name="BGMPlayer" type="AudioStreamPlayer" parent="."]
stream = ExtResource("2_bgm")
bus = &"BGM"

[node name="SEPlayer" type="AudioStreamPlayer" parent="."]
bus = &"SE"

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 0
offset_left = 64.0
offset_top = 64.0
offset_right = 464.0
offset_bottom = 400.0
theme_override_constants/separation = 8

[node name="JumpButton" type="Button" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "効果音：ジャンプ"

[node name="CoinButton" type="Button" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "効果音：コイン"

[node name="HitButton" type="Button" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "効果音：ダメージ"

[node name="BGMButton" type="CheckButton" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "BGM を再生"

[node name="BGMLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "BGM バスの音量"

[node name="BGMVolume" type="HSlider" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
max_value = 1.0
step = 0.01
value = 1.0

[node name="SELabel" type="Label" parent="VBox"]
layout_mode = 2
text = "SE バスの音量"

[node name="SEVolume" type="HSlider" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
max_value = 1.0
step = 0.01
value = 1.0
