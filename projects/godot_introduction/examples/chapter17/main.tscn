[gd_scene format=3]

[ext_resource type="Script" path="res://chapter17/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://chapter17/rock.tscn" id="2_rock"]
[ext_resource type="PackedScene" path="res://chapter17/player.tscn" id="3_player"]
[ext_resource type="PackedScene" path="res://chapter17/hud.tscn" id="4_hud"]
[ext_resource type="AudioStream" path="res://assets/bgm.wav" id="5_bgm"]
[ext_resource type="AudioStream" path="res://assets/hit.wav" id="6_hit"]

[node name="Main" type="Node"]
script = ExtResource("1_main")
rock_scene = ExtResource("2_rock")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.16, 0.2, 0.3, 1)

[node name="Player" parent="." instance=ExtResource("3_player")]

[node name="StartPosition" type="Marker2D" parent="."]
position = Vector2(576, 560)

[node name="RockTimer" type="Timer" parent="."]
wait_time = 0.6

[node name="ScoreTimer" type="Timer" parent="."]

[node name="StartTimer" type="Timer" parent="."]
wait_time = 2.0
one_shot = true

[node name="HUD" parent="." instance=ExtResource("4_hud")]

[node name="Music" type="AudioStreamPlayer" parent="."]
stream = ExtResource("5_bgm")
bus = &"BGM"

[node name="HitSound" type="AudioStreamPlayer" parent="."]
stream = ExtResource("6_hit")
bus = &"SE"
