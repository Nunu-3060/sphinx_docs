<Project Sdk="Microsoft.NET.Sdk">

  <!--
    examples フォルダーのサンプルコードを、UnityEngine のスタブと一緒にコンパイルするための検査用プロジェクトです。
    Unity 6 が対応している C# 9.0 に言語バージョンを合わせています。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS0649: [SerializeField] のフィールドは Unity が値を設定するため、「代入されていない」という警告を抑制します。 -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Stubs\**\*.cs" />
    <Compile Include="..\..\examples\**\*.cs" Link="examples\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
