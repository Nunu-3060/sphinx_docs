digraph report {
    rankdir=LR;
    main [label="main\n（全体の流れ）"];
    load [label="load_sales\n（読み込み）"];
    valid [label="is_valid\n（集計の対象の判定）"];
    total [label="total_by_category\n（集計）"];
    format [label="format_report\n（整形）"];
    sale [label="Sale\n（1 件の売上）", shape=note, style=filled];
    main -> load;
    main -> valid;
    main -> total;
    main -> format;
    load -> sale [style=dashed];
    total -> sale [style=dashed];
}
