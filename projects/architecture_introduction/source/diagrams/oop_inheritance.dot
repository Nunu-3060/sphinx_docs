digraph inheritance {
    rankdir=BT;
    EmailNotifier [fillcolor="#fdecea"];
    SlackNotifier [fillcolor="#fdecea"];
    LoggingEmailNotifier [fillcolor="#fdecea"];
    LoggingSlackNotifier [fillcolor="#fdecea"];
    LoggingEmailNotifier -> EmailNotifier [arrowhead=empty];
    LoggingSlackNotifier -> SlackNotifier [arrowhead=empty];
    RetryingLoggingEmailNotifier [label="RetryingLoggingEmailNotifier\n（さらに増える）", style="rounded,dashed,filled", fillcolor="#fdecea"];
    RetryingLoggingSlackNotifier [label="RetryingLoggingSlackNotifier\n（さらに増える）", style="rounded,dashed,filled", fillcolor="#fdecea"];
    RetryingLoggingEmailNotifier -> LoggingEmailNotifier [arrowhead=empty, style=dashed];
    RetryingLoggingSlackNotifier -> LoggingSlackNotifier [arrowhead=empty, style=dashed];
}
