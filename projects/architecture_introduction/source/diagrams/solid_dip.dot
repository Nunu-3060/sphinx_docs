digraph dip {
    rankdir=TB;
    subgraph cluster_bad {
        label="悪い例";
        style=dashed;
        bad_high [label="BadPasswordReset\n（上位）"];
        bad_low [label="SmtpMailer\n（下位）"];
        bad_high -> bad_low [label="依存"];
    }
    subgraph cluster_good {
        label="良い例";
        style=dashed;
        good_high [label="PasswordReset\n（上位）"];
        abstract [label="MessageSender\n（抽象）", shape=component, fillcolor="#fff7e0"];
        good_low [label="SmtpSender\n（下位）"];
        test_low [label="RecordingSender\n（テスト用）"];
        good_high -> abstract [label="依存"];
        good_low -> abstract [label="満たす", arrowhead=empty, style=dashed];
        test_low -> abstract [arrowhead=empty, style=dashed];
    }
}
