digraph circular_bad {
    rankdir=LR;
    bad_main [label="main"];
    bad_customers [label="customers", fillcolor="#fdecea"];
    bad_orders [label="orders", fillcolor="#fdecea"];
    bad_main -> bad_customers;
    bad_main -> bad_orders;
    bad_customers -> bad_orders [color="#c0392b"];
    bad_orders -> bad_customers [color="#c0392b"];
}
