digraph circular_good {
    rankdir=LR;
    good_main [label="main"];
    good_reports [label="reports"];
    good_orders [label="orders"];
    good_customers [label="customers"];
    good_main -> good_reports;
    good_main -> good_orders [style=dashed];
    good_main -> good_customers [style=dashed];
    good_reports -> good_orders;
    good_reports -> good_customers;
    good_orders -> good_customers;
}
