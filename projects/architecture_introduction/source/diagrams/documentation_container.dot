digraph container {
    rankdir=LR;
    customer [label="顧客\n［人］", shape=ellipse, fillcolor="#e8f4ea"];
    subgraph cluster_system {
        label="注文システム";
        style="rounded,dashed";
        web [label="Web アプリケーション\n［Python］\n注文の画面と API"];
        db [label="データベース\n［SQLite］\n注文と明細", shape=cylinder];
        worker [label="配送の連携処理\n［Python のバッチ処理］"];
    }
    delivery [label="配送会社のシステム\n［外部のシステム］", fillcolor="#eeeeee"];
    customer -> web [label="HTTPS"];
    web -> db [label="注文を保存する"];
    worker -> db [label="確定した注文を読む"];
    worker -> delivery [label="配送を依頼する"];
}
