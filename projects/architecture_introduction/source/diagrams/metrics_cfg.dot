digraph cfg {
    node [shape=box];
    start [label="x > 0 ?"];
    pos [label="return \"正\""];
    neg_check [label="x < 0 ?"];
    neg [label="return \"負\""];
    zero [label="return \"ゼロ\""];
    end [label="終了", shape=ellipse];
    start -> pos [label="はい"];
    start -> neg_check [label="いいえ"];
    neg_check -> neg [label="はい"];
    neg_check -> zero [label="いいえ"];
    pos -> end;
    neg -> end;
    zero -> end;
}
