// 1 から 15 までの FizzBuzz
fn fizzbuzz(n: int) -> str {
    if (n % 15 == 0) {
        return "FizzBuzz";
    } else if (n % 3 == 0) {
        return "Fizz";
    } else if (n % 5 == 0) {
        return "Buzz";
    }
    return to_str(n);
}

fn main() {
    let i = 1;
    while (i <= 15) {
        print(fizzbuzz(i));
        i = i + 1;
    }
}
