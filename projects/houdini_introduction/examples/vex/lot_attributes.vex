// 区画ごとに、建物を建てるかどうかと建物の高さを決める（Run Over: Primitives）。
float seed = chf("seed");
if (rand(@primnum + seed) < chf("empty_ratio")) {
    removeprim(0, @primnum, 1);    // 空き地にする（ポイントも一緒に消す）
} else {
    float r = rand(@primnum + seed + 0.5);
    f@height = fit01(r, chf("min_height"), chf("max_height"));
}
