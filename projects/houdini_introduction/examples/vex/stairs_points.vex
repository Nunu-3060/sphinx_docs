// 階段の段ごとに 1 個のポイントを作る（Run Over: Detail）。
// 各ポイントには、そこにコピーする箱の大きさを scale アトリビュートで持たせる。
int count = chi("step_count");     // 段数
float rise = chf("step_height");   // 1 段の高さ
float run = chf("step_depth");     // 1 段の奥行き
float width = chf("width");        // 階段の幅

for (int i = 0; i < count; i++) {
    float h = rise * (i + 1);      // i 段目の箱の高さ（床から段の上面まで）
    vector pos = set(0.0, h / 2.0, run * (i + 0.5));
    int pt = addpoint(0, pos);
    setpointattrib(0, "scale", pt, set(width, h, run));
}
