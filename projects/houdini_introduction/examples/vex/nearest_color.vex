// 2 番目の入力（入力番号 1）の最も近いポイントまでの距離で色を付ける（Run Over: Points）。
int near = nearpoint(1, @P);                // 最も近いポイントの番号
vector target = point(1, "P", near);        // そのポイントの位置
float d = distance(@P, target);
float t = clamp(d / chf("max_distance"), 0.0, 1.0);
@Cd = lerp({1.0, 0.3, 0.1}, {0.1, 0.3, 1.0}, t);   // 近いほど赤、遠いほど青
