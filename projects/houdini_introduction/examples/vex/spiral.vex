// ポイントとポリラインを作ってらせんを描く（Run Over: Detail）。
int count = chi("count");        // ポイントの数
float turns = chf("turns");      // 巻き数
float height = chf("height");    // らせんの高さ

int prim = addprim(0, "polyline");
for (int i = 0; i < count; i++) {
    float t = float(i) / (count - 1);        // 0 から 1
    float angle = t * turns * 2.0 * PI;      // ラジアン
    vector pos = set(cos(angle), t * height, sin(angle));
    int pt = addpoint(0, pos);
    addvertex(0, prim, pt);                  // ポイントをポリラインに繋ぐ
}
