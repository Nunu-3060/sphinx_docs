// 退職後の手続きの期限（第 2 章の図）
// 退職日の翌日から数えた期限の順に、手続きを左から右に並べる。
// 箱の間隔は、実際の日数に比例していない。
digraph deadlines {
    graph [rankdir=LR, fontname="BIZ UDGothic", bgcolor="white",
           nodesep=0.25, ranksep=0.3, pad=0.2];
    node  [shape=box, style="rounded,filled", fontname="BIZ UDGothic",
           fontsize=11, fontcolor="#0b0b0b", penwidth=1.5,
           margin="0.12,0.08"];
    edge  [color="#52514e", penwidth=1.5, arrowsize=0.8];

    // 起点
    start [label=<<b>退職日の翌日</b><br/>（資格喪失日）>,
           color="#8a8984", fillcolor="#f2f2f0"];

    // 期限
    node [color="#eb6834", fillcolor="#fdeee7"];
    d14 [label=<<b>14 日以内</b><br/><br align="left"/>・国民健康保険への加入<br align="left"/>・国民年金の切り替え<br align="left"/>>];
    d20 [label=<<b>20 日以内</b><br/><br align="left"/>・任意継続被保険者の<br align="left"/>　資格取得の申し出<br align="left"/>>];

    node [color="#2a78d6", fillcolor="#eaf2fc"];
    d6m [label=<<b>約 6 か月以内</b><br/><br align="left"/>・企業型確定拠出年金の<br align="left"/>　資産の移換<br align="left"/>>];
    d1y [label=<<b>1 年</b><br/><br align="left"/>・基本手当の受給期間の<br align="left"/>　終わり<br align="left"/>>];
    tax [label=<<b>翌年の 3 月 15 日</b><br/><br align="left"/>・所得税の確定申告<br align="left"/>　（還付申告は 5 年以内）<br align="left"/>>];

    start -> d14 -> d20 -> d6m -> d1y -> tax;
}
