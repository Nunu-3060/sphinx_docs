// 退職による国民年金の種別の変化（第 8 章の図）
// 会社員の本人が、第 3 号被保険者の配偶者を扶養している場合に、
// 退職して転職先に入社しないと、本人と配偶者の両方が第 1 号被保険者になる。
digraph pension_types {
    graph [rankdir=LR, fontname="BIZ UDGothic", bgcolor="white",
           nodesep=0.5, ranksep=1.4, pad=0.2, newrank=true];
    node  [shape=box, style="rounded,filled", fontname="BIZ UDGothic",
           fontsize=11, fontcolor="#0b0b0b", penwidth=1.5,
           margin="0.15,0.1", width=2.3];
    edge  [fontname="BIZ UDGothic", fontsize=10, fontcolor="#52514e",
           color="#52514e", penwidth=1.5, arrowsize=0.8];

    subgraph cluster_before {
        label=<<b>在職中</b>>; fontsize=12; color="#c9c8c2"; style=rounded;
        node [color="#2a78d6", fillcolor="#eaf2fc"];
        self_before   [label=<<b>本人</b><br/>第 2 号被保険者<br/>（厚生年金保険に加入）>];
        spouse_before [label=<<b>配偶者</b><br/>第 3 号被保険者<br/>（保険料の負担なし）>];
    }

    subgraph cluster_after {
        label=<<b>退職後（転職先に入社しない場合）</b>>; fontsize=12;
        color="#c9c8c2"; style=rounded;
        node [color="#eb6834", fillcolor="#fdeee7"];
        self_after   [label=<<b>本人</b><br/>第 1 号被保険者<br/>（保険料を自分で納める）>];
        spouse_after [label=<<b>配偶者</b><br/>第 1 号被保険者<br/>（保険料を自分で納める）>];
    }

    self_before -> self_after [label="14 日以内に\n市区町村で手続き"];
    spouse_before -> spouse_after [label="配偶者の手続きも必要\n（60 歳未満の場合）"];
    self_before -> spouse_before [style=dashed, arrowhead=none,
                                  label=" 扶養", constraint=false];
}
