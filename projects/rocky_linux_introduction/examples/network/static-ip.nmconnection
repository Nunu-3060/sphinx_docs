# ------------------------------------------------------------
# static-ip.nmconnection - 固定 IP アドレスを設定する keyfile 形式の例
#
# 第 11 章「ネットワーク」で使用します。
# interface-name と各アドレスは、実際の環境に合わせて変更してください。
#
# 配置と反映:
#   sudo install -m 600 static-ip.nmconnection \
#       /etc/NetworkManager/system-connections/
#   sudo nmcli connection reload
#   sudo nmcli connection up static-ip
#
# 注意: ファイルの所有者が root で、パーミッションが 600 でないと
#       NetworkManager はこのファイルを読み込みません。
# ------------------------------------------------------------
[connection]
id=static-ip
type=ethernet
interface-name=enp1s0
autoconnect=true

[ipv4]
method=manual
# IP アドレス/プレフィックス長
address1=192.168.10.20/24
gateway=192.168.10.1
# DNS サーバー (複数ある場合は ; で区切る)
dns=192.168.10.1;8.8.8.8;
dns-search=example.com;

[ipv6]
method=auto
