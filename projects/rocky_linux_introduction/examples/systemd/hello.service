# ------------------------------------------------------------
# hello.service - 自作サービスの最小例
#
# 第 8 章「プロセスとサービスの管理」で使用します。
# 60 秒ごとにメッセージを出力するだけのサービスです。
# 出力は journald に記録され、journalctl -u hello で確認できます。
#
# 配置と起動:
#   sudo cp hello.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hello.service
# ------------------------------------------------------------
[Unit]
Description=Hello sample service
After=network.target

[Service]
Type=simple
# 一般ユーザーの権限で実行する
DynamicUser=yes
ExecStart=/usr/bin/sh -c 'while true; do echo "hello from systemd"; sleep 60; done'
# 異常終了した場合は 5 秒後に再起動する
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
