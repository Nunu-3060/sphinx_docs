# ------------------------------------------------------------
# backup.timer - backup.service を毎日 2 時に起動するタイマー
#
# 第 8 章で使用します。
#
# 有効化と確認:
#   sudo systemctl enable --now backup.timer
#   systemctl list-timers backup.timer
# ------------------------------------------------------------
[Unit]
Description=Run backup.service daily at 02:00

[Timer]
# 毎日 2 時 0 分に実行する
OnCalendar=*-*-* 02:00:00
# 停止中で実行できなかった場合は、次回起動時に実行する
Persistent=true
# 複数のサーバーで同時に実行されないよう、最大 10 分ずらす
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
