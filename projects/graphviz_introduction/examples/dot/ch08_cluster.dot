// クラスター：名前が cluster で始まるサブグラフは枠で囲まれる
digraph cluster {
    graph [fontname="Meiryo"];
    node [shape=box, fontname="Meiryo"];

    subgraph cluster_frontend {
        label="フロントエンド";
        style=filled;
        fillcolor=aliceblue;
        browser; app;
    }

    subgraph cluster_backend {
        label="バックエンド";
        style=filled;
        fillcolor=honeydew;
        api; worker;

        // クラスターは入れ子にできる
        subgraph cluster_storage {
            label="ストレージ";
            fillcolor=white;
            db; queue;
        }
    }

    browser -> app -> api;
    api -> db;
    api -> queue -> worker -> db;
}
