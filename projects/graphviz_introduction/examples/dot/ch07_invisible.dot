// 見えないエッジで並び順を整える
digraph invisible {
    node [shape=box];

    // 3 つの段を縦に並べるため、各段の先頭を見えないエッジでつなぐ
    step1 -> step2 -> step3 [style=invis];

    step1 -> detail1;
    step2 -> detail2;
    step3 -> detail3;

    {rank=same; step1; detail1;}
    {rank=same; step2; detail2;}
    {rank=same; step3; detail3;}
}
