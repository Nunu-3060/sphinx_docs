// HTML 風ラベル：label=< ... > で表形式のノードを作る
digraph html_label {
    node [shape=plain];

    user [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
            <tr><td bgcolor="lightblue"><b>User</b></td></tr>
            <tr><td align="left" port="id">id: int</td></tr>
            <tr><td align="left">name: str</td></tr>
            <tr><td align="left" port="group">group_id: int</td></tr>
        </table>
    >];

    group [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
            <tr><td bgcolor="lightblue"><b>Group</b></td></tr>
            <tr><td align="left" port="id">id: int</td></tr>
            <tr><td align="left"><font color="gray40">name: str</font></td></tr>
        </table>
    >];

    user:group -> group:id;
}
