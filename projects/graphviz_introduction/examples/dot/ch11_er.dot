// ER 図：HTML 風ラベルでテーブルを表し、ポートで列どうしを結ぶ
digraph er {
    graph [rankdir=LR, fontname="Meiryo"];
    node [shape=plain, fontname="Meiryo"];
    edge [arrowhead=crow, arrowtail=tee, dir=both];

    customers [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
            <tr><td bgcolor="lightblue"><b>customers</b></td></tr>
            <tr><td align="left" port="id"><u>customer_id</u></td></tr>
            <tr><td align="left">name</td></tr>
            <tr><td align="left">email</td></tr>
        </table>
    >];

    orders [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
            <tr><td bgcolor="lightblue"><b>orders</b></td></tr>
            <tr><td align="left" port="id"><u>order_id</u></td></tr>
            <tr><td align="left" port="customer">customer_id</td></tr>
            <tr><td align="left">ordered_on</td></tr>
        </table>
    >];

    order_items [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
            <tr><td bgcolor="lightblue"><b>order_items</b></td></tr>
            <tr><td align="left" port="order"><u>order_id</u></td></tr>
            <tr><td align="left" port="product"><u>product_id</u></td></tr>
            <tr><td align="left">quantity</td></tr>
        </table>
    >];

    products [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
            <tr><td bgcolor="lightblue"><b>products</b></td></tr>
            <tr><td align="left" port="id"><u>product_id</u></td></tr>
            <tr><td align="left">name</td></tr>
            <tr><td align="left">price</td></tr>
        </table>
    >];

    // 「1 対多」の関係を、1 側に tee、多側に crow の矢印で表す
    customers:id -> orders:customer;
    orders:id -> order_items:order;
    products:id -> order_items:product;
}
