// compound=true と lhead、ltail でクラスターの枠にエッジをつなぐ
digraph compound {
    compound=true;
    node [shape=box];

    subgraph cluster_a {
        label="cluster_a";
        a1; a2;
    }

    subgraph cluster_b {
        label="cluster_b";
        b1; b2;
    }

    // ltail で始点を、lhead で終点をクラスターの枠にする
    a1 -> b1 [ltail=cluster_a, lhead=cluster_b];
    a2 -> b2;
}
