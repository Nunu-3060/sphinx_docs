// 色の指定方法
digraph colors {
    node [shape=box, style=filled, fontcolor=white];

    // 色名で指定する
    named [label="steelblue", fillcolor=steelblue];

    // #RRGGBB で指定する
    rgb [label="#2E8B57", fillcolor="#2E8B57"];

    // #RRGGBBAA で透明度を指定する（AA は 00 で透明、FF で不透明）
    alpha [label="#2E8B5780", fillcolor="#2E8B5780", fontcolor=black];

    // 枠の色（color）、文字の色（fontcolor）、線の太さ（penwidth）
    border [label="color / penwidth", style=solid, color=crimson,
            fontcolor=crimson, penwidth=3];

    named -> rgb -> alpha -> border [color=gray50, penwidth=2];
}
