// 主なノードの形（shape）の一覧
digraph shapes {
    graph [nodesep=0.4, ranksep=0.3];
    node [fixedsize=true, width=1.3, height=0.6, fontsize=11];
    edge [style=invis];

    // 見えないエッジで 4 列に並べる
    box -> rect -> square -> plaintext -> plain -> underline;
    ellipse -> oval -> circle -> doublecircle -> point -> egg;
    diamond -> triangle -> invtriangle -> trapezium -> parallelogram -> house;
    cylinder -> note -> tab -> folder -> box3d -> component;

    box [shape=box];
    rect [shape=rect];
    square [shape=square, width=0.6];
    plaintext [shape=plaintext];
    plain [shape=plain, fixedsize=false];
    underline [shape=underline];
    ellipse [shape=ellipse];
    oval [shape=oval];
    circle [shape=circle, width=0.6];
    doublecircle [shape=doublecircle, width=0.6, fontsize=8];
    point [shape=point, width=0.1];
    egg [shape=egg];
    diamond [shape=diamond];
    triangle [shape=triangle];
    invtriangle [shape=invtriangle, fontsize=9];
    trapezium [shape=trapezium];
    parallelogram [shape=parallelogram, fontsize=9];
    house [shape=house];
    cylinder [shape=cylinder];
    note [shape=note];
    tab [shape=tab];
    folder [shape=folder];
    box3d [shape=box3d];
    component [shape=component];
}
