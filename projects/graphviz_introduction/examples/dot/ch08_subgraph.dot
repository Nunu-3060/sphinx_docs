// サブグラフ：属性をまとめて指定する範囲として使う
digraph subgraph_attrs {
    node [shape=box];

    subgraph inputs {
        node [style=filled, fillcolor=lightyellow];
        csv; json;
    }

    subgraph outputs {
        node [style=filled, fillcolor=lightblue];
        report; dashboard;
    }

    {csv json} -> loader -> {report dashboard};
}
