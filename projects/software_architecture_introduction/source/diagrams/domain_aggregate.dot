digraph aggregate {
    rankdir=LR;
    subgraph cluster_order {
        label="注文の集約";
        style="rounded,dashed";
        order [label="Order\n（集約ルート、エンティティ）", fillcolor="#fff7e0"];
        line1 [label="OrderLine\n（値オブジェクト）"];
        line2 [label="OrderLine\n（値オブジェクト）"];
        money [label="Money\n（値オブジェクト）"];
        order -> line1;
        order -> line2;
        line1 -> money;
    }
    service [label="OrderService"];
    repository [label="OrderRepository"];
    service -> order [label="メソッドを呼ぶ"];
    service -> repository [label="保存・取得"];
    repository -> order [label="まるごと扱う", style=dashed];
}
