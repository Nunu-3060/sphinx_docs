digraph hexagonal {
    rankdir=LR;
    subgraph cluster_core {
        label="アプリケーションの中心";
        style="rounded,filled";
        fillcolor="#eef6fb";
        service [label="TaskService\n（service.py）"];
        domain [label="Task\n（domain.py）"];
        port [label="TaskRepository\n（ports.py）", shape=component, fillcolor="#fff7e0"];
        service -> domain;
        service -> port;
    }
    cli [label="TextCommandAdapter\n（駆動する側）"];
    memory [label="InMemoryTaskRepository\n（駆動される側）"];
    json [label="JsonFileTaskRepository\n（駆動される側）"];
    cli -> service;
    memory -> port [arrowhead=empty, style=dashed, label="満たす"];
    json -> port [arrowhead=empty, style=dashed];
}
