digraph root {
    rankdir=LR;
    root [label="build_service\n（コンポジションルート）", fillcolor="#fff7e0"];
    settings [label="Settings\n（設定）", shape=note];
    greeter [label="MorningGreeter"];
    http [label="HttpWeatherClient"];
    fixed [label="FixedWeatherClient"];
    clock [label="datetime.now"];
    settings -> root [label="読む", style=dashed];
    root -> greeter [label="作る"];
    root -> http [label="URL があれば作る"];
    root -> fixed [label="URL がなければ作る"];
    root -> clock [label="選ぶ"];
}
