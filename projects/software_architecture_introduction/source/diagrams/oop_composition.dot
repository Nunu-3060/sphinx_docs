digraph composition {
    rankdir=LR;
    Notifier [fillcolor="#e8f4ea"];
    Notifier -> Sender [label="持つ"];
    Sender [label="Sender\n（Protocol）", shape=component, fillcolor="#fff7e0"];
    EmailSender -> Sender [arrowhead=empty, style=dashed, label="満たす"];
    SlackSender -> Sender [arrowhead=empty, style=dashed];
    LoggingSender -> Sender [arrowhead=empty, style=dashed];
    RetryingSender -> Sender [arrowhead=empty, style=dashed];
    {rank=same; EmailSender; SlackSender; LoggingSender; RetryingSender;}
}
