digraph states {
    rankdir=LR;
    DRAFT [shape=ellipse];
    PLACED [shape=ellipse];
    SHIPPED [shape=ellipse];
    CANCELLED [shape=ellipse];
    DRAFT -> PLACED [label="place"];
    DRAFT -> CANCELLED [label="cancel"];
    PLACED -> SHIPPED [label="ship"];
    PLACED -> CANCELLED [label="cancel"];
}
