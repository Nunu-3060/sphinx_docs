digraph context {
    rankdir=LR;
    customer [label="顧客\n［人］", shape=ellipse, fillcolor="#e8f4ea"];
    system [label="注文システム\n［ソフトウェアシステム］\n商品の注文を受け付ける", fillcolor="#fff7e0"];
    delivery [label="配送会社のシステム\n［外部のシステム］", fillcolor="#eeeeee"];
    mail [label="メール配信サービス\n［外部のシステム］", fillcolor="#eeeeee"];
    customer -> system [label="商品を注文する"];
    system -> delivery [label="配送を依頼する"];
    system -> mail [label="確認のメールを送る"];
}
