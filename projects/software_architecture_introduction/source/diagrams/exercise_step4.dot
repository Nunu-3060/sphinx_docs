digraph step4 {
    rankdir=LR;
    main [label="main.py\n（コンポジションルート）", fillcolor="#fff7e0"];
    cli [label="cli.py"];
    service [label="service.py\nInventoryService"];
    repository [label="domain.py\nItemRepository", shape=component, fillcolor="#fff7e0"];
    json [label="repository.py\nJsonFileItemRepository"];
    memory [label="repository.py\nInMemoryItemRepository"];
    domain [label="domain.py\nItem", fillcolor="#e8f4ea"];
    test [label="test_service.py", shape=note];
    main -> cli;
    main -> service;
    main -> json [label="作る"];
    cli -> service;
    service -> repository;
    service -> domain;
    json -> repository [arrowhead=empty, style=dashed, label="満たす"];
    memory -> repository [arrowhead=empty, style=dashed];
    test -> service [style=dotted];
    test -> memory [style=dotted, label="使う"];
}
