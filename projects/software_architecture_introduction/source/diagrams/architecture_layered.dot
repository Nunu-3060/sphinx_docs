digraph layered {
    rankdir=TB;
    node [width=3.2];
    presentation [label="プレゼンテーション層\npresentation.py"];
    application [label="アプリケーション層\napplication.py"];
    domain [label="ドメイン層\ndomain.py"];
    infrastructure [label="インフラストラクチャ層\ninfrastructure.py", fillcolor="#fdecea"];
    presentation -> application;
    application -> domain;
    application -> infrastructure;
    presentation -> domain [style=dashed];
}
