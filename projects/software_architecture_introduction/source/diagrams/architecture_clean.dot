digraph clean {
    compound=true;
    rankdir=TB;
    subgraph cluster_frameworks {
        label="フレームワークとドライバー（Web フレームワーク、データベース、画面）";
        style="rounded,filled";
        fillcolor="#f3f0fa";
        subgraph cluster_adapters {
            label="インターフェースアダプター（コントローラー、プレゼンター、リポジトリの実装）";
            fillcolor="#eef6fb";
            subgraph cluster_usecases {
                label="ユースケース（アプリケーションサービス）";
                fillcolor="#e8f4ea";
                subgraph cluster_entities {
                    label="エンティティ（業務の規則）";
                    fillcolor="#fff7e0";
                    entities [label="Task、Order など", shape=plaintext, style=""];
                }
                usecases [label="TaskService など", shape=plaintext, style=""];
            }
            adapters [label="アダプター", shape=plaintext, style=""];
        }
        frameworks [label="外部の技術", shape=plaintext, style=""];
    }
    frameworks -> adapters [label="依存"];
    adapters -> usecases [label="依存"];
    usecases -> entities [label="依存"];
}
