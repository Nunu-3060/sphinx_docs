; Engine configuration file.
; Dodge Lab: a small game for experimenting with game feel and difficulty.

config_version=5

[application]

config/name="Dodge Lab"
config/description="Avoid falling blocks. Change the parameters of the Main node in the Inspector."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0

[display]

window/size/viewport_width=640
window/size/viewport_height=480

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
