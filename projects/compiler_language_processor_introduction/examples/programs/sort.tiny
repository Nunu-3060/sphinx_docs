// 配列の挿入ソート
fn sort(a: [int]) {
    let i = 1;
    while (i < len(a)) {
        let key = a[i];
        let j = i - 1;
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];
            j = j - 1;
        }
        a[j + 1] = key;
        i = i + 1;
    }
}

fn main() {
    let data = [5, 2, 9, 1, 7, 3];
    print("before:", data);
    sort(data);
    print("after: ", data);
}
