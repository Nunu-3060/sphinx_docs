# ------------------------------------------------------------
# backup.service - backup.sh を実行するサービス
#
# 第 8 章と第 10 章で使用します。backup.timer から起動されます。
# 単体で実行する場合は sudo systemctl start backup.service とします。
#
# 配置:
#   sudo install -m 755 backup.sh /usr/local/sbin/backup.sh
#   sudo cp backup.service backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
# ------------------------------------------------------------
[Unit]
Description=Daily backup of /etc and /srv/www

[Service]
# 処理が終わると終了する種類のサービス
Type=oneshot
Environment=BACKUP_DIR=/var/backup
Environment=RETENTION_DAYS=7
ExecStart=/usr/local/sbin/backup.sh
# バックアップ処理で他の処理を妨げないよう、優先度を下げる
Nice=10
IOSchedulingClass=idle
