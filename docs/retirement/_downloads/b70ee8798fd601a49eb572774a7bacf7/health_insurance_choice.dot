// 退職後の医療保険の選び方（第 7 章の図）
// 質問（灰色の枠）に「はい」「いいえ」で答えて、加入する医療保険（青色の枠）を選ぶ。
digraph health_insurance_choice {
    graph [rankdir=TB, fontname="BIZ UDGothic", bgcolor="white",
           nodesep=0.4, ranksep=0.45, pad=0.2];
    node  [shape=box, style="rounded,filled", fontname="BIZ UDGothic",
           fontsize=11, fontcolor="#0b0b0b", penwidth=1.5,
           margin="0.15,0.1"];
    edge  [fontname="BIZ UDGothic", fontsize=10, fontcolor="#52514e",
           color="#52514e", penwidth=1.2, arrowsize=0.8];

    // 質問
    node [color="#8a8984", fillcolor="#f2f2f0"];
    q1 [label="退職日の翌日に\n転職先に入社しますか"];
    q2 [label="家族の健康保険の\n被扶養者になれますか\n（収入の見込みが 130 万円未満など）"];
    q3 [label="任意継続被保険者と\n国民健康保険の保険料を\n比べると、どちらが安いですか"];

    // 選択肢
    node [color="#2a78d6", fillcolor="#eaf2fc"];
    a1 [label="転職先の健康保険\n（手続きは転職先が行う）"];
    a2 [label="家族の健康保険の被扶養者\n（保険料の負担なし）"];
    a3 [label="任意継続被保険者\n（退職日の翌日から 20 日以内）"];
    a4 [label="国民健康保険\n（退職日の翌日から 14 日以内）"];

    q1 -> a1 [label=" はい"];
    q1 -> q2 [label=" いいえ"];
    q2 -> a2 [label=" はい"];
    q2 -> q3 [label=" いいえ"];
    q3 -> a3 [label=" 任意継続"];
    q3 -> a4 [label=" 国民健康保険"];

    {rank=same; q2; a1;}
    {rank=same; q3; a2;}
}
