// 退職の流れ（第 2 章の図）
// 4 つの時期と、それぞれの時期の主な活動を左から右に並べる。
digraph retirement_flow {
    graph [rankdir=LR, fontname="BIZ UDGothic", bgcolor="white",
           nodesep=0.3, ranksep=0.35, pad=0.2];
    node  [shape=box, style="rounded,filled", fontname="BIZ UDGothic",
           fontsize=11, fontcolor="#0b0b0b", color="#2a78d6",
           fillcolor="#eaf2fc", penwidth=1.5, margin="0.15,0.1"];
    edge  [color="#52514e", penwidth=1.5, arrowsize=0.8];

    before [label=<<b>退職を決める前</b><br align="left"/><br align="left"/>・退職後の進路の検討<br align="left"/>・お金の見通し<br align="left"/>・就業規則の確認<br align="left"/>・退職日の検討<br align="left"/>>];
    notice [label=<<b>退職の 1〜3 か月前</b><br align="left"/><br align="left"/>・上司への意思表示<br align="left"/>・退職日の確定<br align="left"/>・退職届の提出<br align="left"/>>];
    last   [label=<<b>退職日まで</b><br align="left"/><br align="left"/>・業務の引き継ぎ<br align="left"/>・年次有給休暇の消化<br align="left"/>・貸与品の返却<br align="left"/>・書類の受け取りの確認<br align="left"/>>];
    after  [label=<<b>退職後</b><br align="left"/><br align="left"/>・健康保険の切り替え<br align="left"/>・年金の切り替え<br align="left"/>・基本手当の申請<br align="left"/>・税金の手続き<br align="left"/>>,
            color="#eb6834", fillcolor="#fdeee7"];

    before -> notice -> last -> after;
}
