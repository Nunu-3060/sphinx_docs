// 第 10 章のサンプル: Jenkins の宣言型パイプラインです。
// 実際に使う場合はリポジトリ直下に Jenkinsfile として配置します。
// Linux のエージェントに Python 3.12 以上がインストールされていることを前提とします。
pipeline {
    agent { label 'python' }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Setup') {
            steps {
                sh 'python3 -m venv .venv'
                sh '.venv/bin/python -m pip install nox==2026.8.17'
            }
        }
        stage('Quality checks') {
            steps {
                sh '.venv/bin/nox'
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'reports/junit.xml'
        }
        failure {
            echo '品質検査に失敗しました。ログを確認してください。'
        }
    }
}
