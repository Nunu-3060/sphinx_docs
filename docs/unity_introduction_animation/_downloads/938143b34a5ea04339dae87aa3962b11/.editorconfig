# Unity アニメーション入門 サンプルコード用の EditorConfig
# 検査方法（examples フォルダーの親フォルダーで実行する）:
#   dotnet format whitespace --folder examples --verify-no-changes

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4

# ----------------------------------------
# using ディレクティブ
# ----------------------------------------
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# ----------------------------------------
# 改行と波かっこ
# ----------------------------------------
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_prefer_braces = true:warning

# ----------------------------------------
# インデントと空白
# ----------------------------------------
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_space_after_comma = true
csharp_space_after_semicolon_in_for_statement = true
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# ----------------------------------------
# コードスタイル
# ----------------------------------------
# this. は付けない
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# int や float などは型名を明示する
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# アクセス修飾子は常に明示する
dotnet_style_require_accessibility_modifiers = always:warning

# Unity は readonly フィールドをシリアライズしないため、
# [SerializeField] のフィールドが readonly にされないよう無効にする。
dotnet_style_readonly_field = false
dotnet_diagnostic.IDE0044.severity = none

# Update() などの Unity のメッセージ関数は private のまま
# コード中から呼ばれないため、未使用メンバーの警告を無効にする。
dotnet_diagnostic.IDE0051.severity = none

# OnAnimatorIK(int layerIndex) などは Unity が決めた引数を持つため、
# 引数を使わない場合でも削除できない。未使用引数の警告を無効にする。
dotnet_diagnostic.IDE0060.severity = none

# [SerializeField] のフィールドは Inspector ウィンドウから値が設定されるため、
# 「代入されていない」という警告を無効にする。
dotnet_diagnostic.CS0649.severity = none

# 初学者向けのサンプルのため、名前空間は使用しない。
dotnet_diagnostic.CA1050.severity = none

# 読みやすさを優先し、new Vector3(...) のように型名を明示する。
csharp_style_implicit_object_creation_when_type_is_apparent = false

# 読みやすさを優先し、switch 式ではなく switch 文を使う。
csharp_style_prefer_switch_expression = false

# ----------------------------------------
# 命名規則
# ----------------------------------------
# 型・メソッド・プロパティ・イベント: PascalCase
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, interface, enum, method, property, event, delegate
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_rule.types_and_members_should_be_pascal_case.symbols = types_and_members
dotnet_naming_rule.types_and_members_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.types_and_members_should_be_pascal_case.severity = warning

# 定数と static readonly フィールド: PascalCase
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_rule.constant_fields_should_be_pascal_case.symbols = constant_fields
dotnet_naming_rule.constant_fields_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.constant_fields_should_be_pascal_case.severity = warning

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_rule.static_readonly_fields_should_be_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.static_readonly_fields_should_be_pascal_case.severity = warning

# private フィールド: camelCase（Unity の慣習に合わせ、接頭辞は付けない）
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = camel_case
dotnet_naming_rule.private_fields_should_be_camel_case.severity = warning

# 引数とローカル変数: camelCase
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local
dotnet_naming_rule.locals_and_parameters_should_be_camel_case.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_should_be_camel_case.style = camel_case
dotnet_naming_rule.locals_and_parameters_should_be_camel_case.severity = warning
