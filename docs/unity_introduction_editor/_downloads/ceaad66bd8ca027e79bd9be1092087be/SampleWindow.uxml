<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- src は、この UXML ファイルからの相対パスです。 -->
    <ui:Style src="SampleWindow.uss" />
    <ui:VisualElement class="container">
        <ui:Label text="選択中のオブジェクト" class="heading" />
        <ui:Label name="count-label" text="選択数：0" />
        <ui:Label name="names-label" text="（なし）" class="names" />
        <ui:VisualElement class="button-row">
            <ui:Button name="ping-button" text="場所を表示" />
            <ui:Button name="clear-button" text="選択を解除" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
