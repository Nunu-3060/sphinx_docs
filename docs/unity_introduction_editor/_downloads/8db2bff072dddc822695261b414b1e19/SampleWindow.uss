/* SampleWindow.uxml のスタイルです。 */

.container {
    padding: 8px;
}

.heading {
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 4px;
}

.names {
    margin-top: 4px;
    margin-bottom: 4px;
    padding: 4px;
    background-color: rgba(0, 0, 0, 0.15);
    white-space: normal;
}

.button-row {
    flex-direction: row;
}

/* .button-row の直下にある Button 要素を、同じ幅で横に並べます。 */
.button-row > Button {
    flex-grow: 1;
    flex-basis: 0;
}
