# ============================================================
# ~/.gitconfig の設定例
#   git config --global コマンドで設定すると、このファイルに書き込まれます。
#   name と email は自分のものに書き換えてください。
# ============================================================

[user]
	name = Taro Yamada
	email = taro@example.com

[init]
	# git init で作成される最初のブランチ名
	defaultBranch = main

[core]
	# コミットメッセージなどを編集するエディター（例: VS Code）
	editor = code --wait
	# 日本語のファイル名をエスケープせずにそのまま表示する
	quotepath = false

[pull]
	# git pull で fast-forward できない場合は、マージせずにエラーにする
	ff = only

[alias]
	st = status --short --branch
	lg = log --oneline --graph --all
