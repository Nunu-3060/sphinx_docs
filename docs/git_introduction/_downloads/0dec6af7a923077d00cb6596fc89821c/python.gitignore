# ============================================================
# Python プロジェクト向けの .gitignore の例
#   使うときはファイル名を .gitignore に変更して、
#   リポジトリの最上位ディレクトリに置きます。
# ============================================================

# バイトコードとキャッシュ
__pycache__/
*.py[cod]

# 仮想環境
.venv/
venv/

# パッケージングで生成されるファイル
build/
dist/
*.egg-info/

# テストやツールのキャッシュ
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter Notebook のチェックポイント
.ipynb_checkpoints/

# 秘密情報を含む環境変数ファイル
.env

# エディターや OS が生成するファイル
.vscode/
.idea/
.DS_Store
Thumbs.db
