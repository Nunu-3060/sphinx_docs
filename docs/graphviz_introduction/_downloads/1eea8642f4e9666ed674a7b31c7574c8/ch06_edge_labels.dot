// ラベルの種類：label、xlabel、headlabel、taillabel
digraph edge_labels {
    rankdir=LR;
    node [shape=box];

    // xlabel はノードやエッジの外側に表示される
    client [xlabel="xlabel"];

    // label はエッジの中央、taillabel は始点側、headlabel は終点側に表示される
    client -> server [label="label", taillabel="tail", headlabel="head"];
}
