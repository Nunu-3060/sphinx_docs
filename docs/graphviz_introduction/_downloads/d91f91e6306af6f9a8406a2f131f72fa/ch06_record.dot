// record シェイプ：ラベルを | で区切ってフィールドに分ける
digraph record {
    node [shape=record];

    // {} で囲むと区切りの方向が縦横入れ替わる
    // <name> はフィールドに付けるポート名で、エッジの接続先に使える
    user [label="{User|<id> id: int|name: str|<group> group_id: int}"];
    group [label="{Group|<id> id: int|name: str}"];

    user:group -> group:id;
}
