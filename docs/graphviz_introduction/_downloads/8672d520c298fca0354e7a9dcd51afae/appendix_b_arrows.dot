// 主な矢印の形（arrowhead）の一覧
digraph arrows {
    node [shape=plaintext, fontsize=11];

    // 終点のノードは点で表示する
    {
        node [shape=point];
        p1; p2; p3; p4; p5; p6; p7; p8;
        q1; q2; q3; q4; q5; q6; q7; q8;
    }

    normal -> p1 [arrowhead=normal];
    inv -> p2 [arrowhead=inv];
    vee -> p3 [arrowhead=vee];
    empty -> p4 [arrowhead=empty];
    dot -> p5 [arrowhead=dot];
    odot -> p6 [arrowhead=odot];
    diamond -> p7 [arrowhead=diamond];
    odiamond -> p8 [arrowhead=odiamond];

    tee -> q1 [arrowhead=tee];
    box -> q2 [arrowhead=box];
    obox -> q3 [arrowhead=obox];
    crow -> q4 [arrowhead=crow];
    curve -> q5 [arrowhead=curve];
    lnormal -> q6 [arrowhead=lnormal];
    rnormal -> q7 [arrowhead=rnormal];
    none -> q8 [arrowhead=none];

    // 見えないエッジで 2 段目を 1 段目の下に置く
    edge [style=invis];
    p1 -> tee;
    p2 -> box;
    p3 -> obox;
    p4 -> crow;
    p5 -> curve;
    p6 -> lnormal;
    p7 -> rnormal;
    p8 -> none;
}
