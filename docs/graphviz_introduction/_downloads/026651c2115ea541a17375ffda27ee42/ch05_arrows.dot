// 矢印の形（arrowhead）と向き（dir）
digraph arrows {
    node [shape=plaintext];

    // 終点のノードは点で表示する
    {
        node [shape=point];
        p1; p2; p3; p4; p5; p6; p7; p8;
    }

    normal -> p1 [arrowhead=normal];
    vee -> p2 [arrowhead=vee];
    empty -> p3 [arrowhead=empty];
    diamond -> p4 [arrowhead=diamond];
    odot -> p5 [arrowhead=odot];
    none -> p6 [arrowhead=none];
    "dir=both" -> p7 [dir=both];
    "dir=back" -> p8 [dir=back];
}
