// 状態遷移図：注文の状態の移り変わり
digraph state_machine {
    graph [rankdir=LR, fontname="Meiryo"];
    node [shape=box, style=rounded, fontname="Meiryo"];
    edge [fontname="Meiryo", fontsize=10];

    // 開始と終了は黒丸で表す
    start [shape=point, width=0.2];
    end [shape=doublecircle, label="", width=0.2, style=filled,
         fillcolor=black];

    pending [label="受付済み"];
    paid [label="支払済み"];
    shipped [label="発送済み"];
    delivered [label="配達完了"];
    cancelled [label="キャンセル"];

    start -> pending;
    pending -> paid [label="支払い"];
    paid -> shipped [label="発送"];
    shipped -> delivered [label="受け取り"];
    delivered -> end;

    pending -> cancelled [label="取り消し"];
    paid -> cancelled [label="返金"];
    cancelled -> end;
}
