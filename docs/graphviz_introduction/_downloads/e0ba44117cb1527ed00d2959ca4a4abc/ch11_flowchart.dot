// フローチャート：ログイン処理の流れ
digraph flowchart {
    graph [fontname="Meiryo"];
    node [shape=box, fontname="Meiryo"];
    edge [fontname="Meiryo", fontsize=10];

    start [label="開始", shape=oval];
    input [label="ID とパスワードを入力", shape=parallelogram];
    check [label="認証に成功したか", shape=diamond];
    count [label="失敗回数に 1 を加える"];
    locked [label="失敗回数が 3 回以上か", shape=diamond];
    lock [label="アカウントをロック"];
    home [label="ホーム画面を表示"];
    end [label="終了", shape=oval];

    start -> input -> check;
    check -> home [label="はい"];
    check -> count [label="いいえ"];
    count -> locked;
    locked -> lock [label="はい"];
    locked -> input [label="いいえ"];
    home -> end;
    lock -> end;
}
