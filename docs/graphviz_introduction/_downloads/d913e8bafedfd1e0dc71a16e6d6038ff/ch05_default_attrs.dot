// 既定の属性をまとめて指定する
digraph defaults {
    // グラフ全体の属性
    graph [label="Default attributes", labelloc=t];

    // 以降に現れるすべてのノードとエッジの属性
    node [shape=box, style=filled, fillcolor=lightyellow];
    edge [color=gray40];

    a -> b;
    a -> c;

    // 個別に指定した属性は既定の属性より優先される
    c [fillcolor=lightblue];
}
