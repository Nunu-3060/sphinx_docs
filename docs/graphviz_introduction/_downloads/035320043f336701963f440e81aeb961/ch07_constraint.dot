// constraint=false のエッジは、段（上下の位置）の決定に使われない
digraph constraint {
    node [shape=box];

    // 開発チームの作業
    design -> implement -> test;

    // 文書チームの作業
    write_docs -> publish;

    // テストの結果を文書に反映する、という関係を表すエッジ。
    // constraint=false がないと、write_docs は test より下の段に置かれる
    test -> write_docs [constraint=false, style=dashed, label="feedback"];
}
