// ノードとエッジのスタイル（style）
digraph styles {
    node [shape=box];

    filled [style=filled, fillcolor=lightgray];
    rounded [style=rounded];
    both [style="rounded,filled", fillcolor=lightgray];
    dashed_node [label="dashed", style=dashed];

    filled -> rounded [style=solid, label="solid"];
    rounded -> both [style=dashed, label="dashed"];
    both -> dashed_node [style=dotted, label="dotted"];
    dashed_node -> filled [style=bold, label="bold"];
}
