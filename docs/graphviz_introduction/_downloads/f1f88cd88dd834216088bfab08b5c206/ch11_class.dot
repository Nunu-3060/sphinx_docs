// クラス図：継承と集約の関係
digraph class_diagram {
    node [shape=record, fontsize=11];
    edge [fontsize=10];

    // {} で区切りを縦方向にし、クラス名、属性、メソッドの 3 段に分ける
    // \l は左揃えの改行、\> は > をそのまま表示するためのエスケープ
    shape [label="{Shape|name: str\l|area() -\> float\l}"];
    circle [label="{Circle|radius: float\l|area() -\> float\l}"];
    rect [label="{Rectangle|width: float\lheight: float\l|area() -\> float\l}"];
    canvas [label="{Canvas|shapes: list[Shape]\l|add(shape: Shape) -\> None\ldraw() -\> None\l}"];

    // 継承：子クラスから親クラスへ、白抜きの三角の矢印を引く
    circle -> shape [arrowhead=empty];
    rect -> shape [arrowhead=empty];

    // 集約：全体の側に白抜きのひし形を付ける
    canvas -> shape [dir=back, arrowtail=odiamond, label="0..*",
                     constraint=false];
}
