// よく使うノードの形（shape）
digraph shapes {
    node [fixedsize=true, width=1.2, height=0.6];

    ellipse [shape=ellipse];
    box [shape=box];
    circle [shape=circle, width=0.8, height=0.8];
    diamond [shape=diamond];
    cylinder [shape=cylinder];
    note [shape=note];
    folder [shape=folder];
    plaintext [shape=plaintext];
}
