// 空白期間の有無による公的手続きの分岐（第 10 章）
// 灰色の箱は質問、青色の箱は転職先が行う手続き、オレンジ色の箱は自分で行う手続きを表す。
digraph procedures {
    graph [rankdir=TB, fontname="BIZ UDGothic", bgcolor="white", nodesep=0.4, ranksep=0.45, pad=0.2];
    node  [fontname="BIZ UDGothic", fontsize=12, shape=box, style="rounded,filled", penwidth=1.4, margin="0.18,0.10"];
    edge  [fontname="BIZ UDGothic", fontsize=11, color="#52514e", arrowsize=0.7];

    question [label="退職日の翌日に\n転職先に入社するか", fillcolor="#efeeea", color="#8a8984"];

    company  [label=<<b>転職先が手続きする</b><br/><br/>健康保険・厚生年金保険の加入<br/>雇用保険の加入>, fillcolor="#dbe9fa", color="#2a78d6"];

    self     [label=<<b>自分で手続きする</b><br/>（空白期間が 1 日でも必要）>, fillcolor="#fbe1d6", color="#eb6834"];

    health   [label=<<b>健康保険（いずれかを選ぶ）</b><br/><br/>任意継続被保険者：20 日以内<br/>国民健康保険：14 日以内<br/>家族の健康保険の被扶養者>, fillcolor="#fbe1d6", color="#eb6834"];
    pension  [label=<<b>年金</b><br/><br/>国民年金の第 1 号被保険者<br/>への種別変更：14 日以内>, fillcolor="#fbe1d6", color="#eb6834"];
    benefit  [label=<<b>雇用保険</b><br/><br/>空白期間が長い場合は<br/>基本手当の受給を検討>, fillcolor="#fbe1d6", color="#eb6834"];

    common   [label=<<b>どちらの場合も行う</b><br/><br/>源泉徴収票を転職先に提出（年末調整）<br/>住民税の納め方の確認<br/>企業型 DC の移換：6 か月以内>, fillcolor="#efeeea", color="#8a8984"];

    question -> company [label="  はい（空白期間なし）"];
    question -> self    [label="  いいえ（空白期間あり）"];
    self -> health;
    self -> pension;
    self -> benefit;

    company -> common;
    health -> common;
    pension -> common;
    benefit -> common;
}
