// 選考の流れの例（第 6 章）
// 実線の箱は多くの企業で行う段階、点線の箱は企業によって行う段階を表す。
digraph selection_flow {
    graph [rankdir=TB, fontname="BIZ UDGothic", bgcolor="white", nodesep=0.5, ranksep=0.45, pad=0.2, newrank=true];
    node  [fontname="BIZ UDGothic", fontsize=12, shape=box, style="rounded,filled", fillcolor="#dbe9fa", color="#2a78d6", penwidth=1.4, margin="0.18,0.10"];
    edge  [fontname="BIZ UDGothic", fontsize=10, color="#52514e", arrowsize=0.7];

    casual    [label="カジュアル面談", style="rounded,filled,dashed", fillcolor="white"];
    apply     [label="応募"];
    documents [label="書類選考"];
    test      [label="コーディングテスト\n技術課題", style="rounded,filled,dashed", fillcolor="white"];
    tech      [label="技術面接"];
    manager   [label="人物面接\n（上司・役員）"];
    reference [label="リファレンス\nチェック", style="rounded,filled,dashed", fillcolor="white"];
    offer     [label="内定", fillcolor="#fbe1d6", color="#eb6834"];
    meeting   [label="条件の確認\n（オファー面談）", fillcolor="#fbe1d6", color="#eb6834"];

    // 3 段に分けて、各段を左から右に並べる。
    { rank=same; casual; apply; documents; }
    { rank=same; test; tech; manager; }
    { rank=same; reference; offer; meeting; }

    casual -> apply [style=dashed];
    apply -> documents;
    documents -> test;
    test -> tech;
    tech -> manager;
    manager -> reference;
    reference -> offer;
    offer -> meeting;
}
