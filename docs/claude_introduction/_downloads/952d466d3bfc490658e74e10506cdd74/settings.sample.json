{
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(flake8 *)",
      "Bash(mypy *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -m flake8 src 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
