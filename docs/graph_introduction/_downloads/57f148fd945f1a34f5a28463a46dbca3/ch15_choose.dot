// グラフを選ぶための判断フロー
// 「何を見せたいか」から出発し、データの性質で候補を絞る
digraph choose {
    rankdir=LR;
    node [fontname="Yu Gothic", fontsize=11];
    edge [fontname="Yu Gothic", fontsize=9];

    start [label="何を見せたいか", shape=box, style="rounded,filled",
           fillcolor="#4e79a7", fontcolor=white];

    node [shape=box, style="rounded,filled", fillcolor="#f6e3b4"];
    compare [label="量の比較"];
    distribution [label="分布"];
    relation [label="関係"];
    composition [label="構成比"];
    time [label="時間変化"];
    structure [label="構造"];

    node [shape=box, style=filled, fillcolor="#dbe9f6"];
    bar [label="棒グラフ\nドットプロット"];
    grouped [label="グループ化棒グラフ\nヒートマップ"];
    hist [label="ヒストグラム\nECDF"];
    box [label="箱ひげ図\nバイオリンプロット"];
    scatter [label="散布図\n（多いときは hexbin）"];
    matrix [label="散布図行列\nヒートマップ\n平行座標プロット"];
    stacked [label="100% 積み上げ棒グラフ\n（項目が少なければ円グラフ）"];
    treemap [label="ツリーマップ\nサンバースト図"];
    line [label="折れ線グラフ\n（段階的ならステップ）"];
    area [label="積み上げ面グラフ"];
    gantt [label="ガントチャート"];
    tree [label="木構造図"];
    flow [label="フローチャート\n状態遷移図\nサンキー図"];
    network [label="ノードリンク図\n（密なら隣接行列）"];

    start -> {compare distribution relation composition time structure};
    compare -> bar [label="項目が 1 系列"];
    compare -> grouped [label="項目 × 系列"];
    distribution -> hist [label="1 グループ"];
    distribution -> box [label="複数グループ"];
    relation -> scatter [label="2 変数"];
    relation -> matrix [label="3 変数以上"];
    composition -> stacked [label="階層なし"];
    composition -> treemap [label="階層あり"];
    time -> line [label="値の推移"];
    time -> area [label="内訳の推移"];
    time -> gantt [label="期間"];
    structure -> tree [label="親子関係"];
    structure -> flow [label="流れ・手順"];
    structure -> network [label="任意のつながり"];
}
