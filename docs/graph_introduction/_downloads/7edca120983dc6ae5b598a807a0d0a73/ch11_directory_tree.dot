// 木構造: プロジェクトのディレクトリ構成
// フォルダーを親、中のファイルやフォルダーを子として、上から下へ描く
digraph directory {
    node [shape=box, fontname="Yu Gothic", style=filled, fillcolor=white];
    edge [arrowhead=none];

    // フォルダーは色を付けて区別する
    project [label="project/", fillcolor="#f6e3b4"];
    src [label="src/", fillcolor="#f6e3b4"];
    tests [label="tests/", fillcolor="#f6e3b4"];
    docs [label="docs/", fillcolor="#f6e3b4"];
    app [label="app/", fillcolor="#f6e3b4"];

    project -> {src tests docs readme};
    readme [label="README.md"];
    src -> {app main};
    main [label="main.py"];
    app -> {models views};
    models [label="models.py"];
    views [label="views.py"];
    tests -> {test_models test_views};
    test_models [label="test_models.py"];
    test_views [label="test_views.py"];
    docs -> index;
    index [label="index.rst"];
}
