// 重み付きグラフ: 5 つの拠点を結ぶ回線と、その遅延時間（ミリ秒）
// エッジのラベルに重みを書く。neato の len 属性（エッジの望ましい長さ）を
// 遅延時間に比例させ、遅い回線ほど長く描く
graph latency {
    layout=neato;
    node [shape=circle, fontname="Yu Gothic", style=filled,
          fillcolor="#dbe9f6", width=0.7, fixedsize=true];
    edge [fontname="Yu Gothic", fontsize=12, fontcolor="#c0392b"];

    東京 -- 大阪 [label="8", len=1.1];
    東京 -- 仙台 [label="5", len=0.9];
    東京 -- 福岡 [label="18", len=2.1];
    大阪 -- 福岡 [label="10", len=1.4];
    仙台 -- 札幌 [label="9", len=1.3];
    東京 -- 札幌 [label="16", len=1.9];
}
