// エラトステネスのふるいで n 以下の素数を求める
fn primes(n: int) -> [int] {
    let sieve: [bool] = [];
    let i = 0;
    while (i <= n) {
        push(sieve, true);
        i = i + 1;
    }
    let result: [int] = [];
    let p = 2;
    while (p <= n) {
        if (sieve[p]) {
            push(result, p);
            let m = p * p;
            while (m <= n) {
                sieve[m] = false;
                m = m + p;
            }
        }
        p = p + 1;
    }
    return result;
}

fn main() {
    let ps = primes(50);
    print(len(ps), "primes:", ps);
}
