// 文字列の反転と回文判定
fn reverse(s: str) -> str {
    let result = "";
    let i = len(s) - 1;
    while (i >= 0) {
        result = result + s[i];
        i = i - 1;
    }
    return result;
}

fn is_palindrome(s: str) -> bool {
    return s == reverse(s);
}

fn main() {
    let words = ["level", "tiny", "racecar", "compiler"];
    let i = 0;
    while (i < len(words)) {
        let w = words[i];
        print(w, reverse(w), is_palindrome(w));
        i = i + 1;
    }
}
